# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
ENV/
env/

# Large Neural Model Binaries (Download via scripts/download_models.py)
models/*
!models/.gitkeep

# Browser Automation & Profile Data
flow_edge_user_data/
flow_browser_profile/
FlowStudio_*Profile/
.playwright/
ms-playwright/

# Batch Outputs & Runtime Logs
outputs/*
!outputs/.gitkeep
archive/
logs/
jobs/
*.log
*_ledger.json

# Personal Media & Inputs (Strict Privacy Protection)
Foto/
inputs/*
!inputs/.gitkeep
templates/*
!templates/.gitkeep
samples/*
!samples/.gitkeep

# JSON Policies: Ignore root/scratch dumps, allow formal configs
*.json
!configs/*.json
!configs/**/*.json
!configs/*.example.json
!data/*.example.json
data/raw/
*.json.bak

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo

# Environment variables & secrets
.env
.env.*
!*.example
